{
  "name": "crashout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Palm Beach Learjet cockpit scenario, adapted from ExoAVData",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:pages": "vite build --outDir docs && node scripts/finish-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": { "cesium": "1.144.0" },
  "devDependencies": { "vite": "8.2.2", "vite-plugin-static-copy": "4.1.1", "playwright": "1.62.1" },
  "overrides": { "@cesium/engine": "26.2.0", "@cesium/widgets": "16.1.1" }
}
